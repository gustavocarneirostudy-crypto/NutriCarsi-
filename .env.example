# Neon Auth Configuration (Exemplo)
VITE_NEON_AUTH_URL=https://<seu-auth-endpoint>.neonauth.c-2.sa-east-1.aws.neon.tech/neondb/auth

# Neon Database URL (Exemplo)
VITE_NEON_DATABASE_URL=postgresql://<usuario>:<senha>@<host-pooler>.neon.tech/neondb?sslmode=require
VITE_NEON_PROJECT_ID=seu-project-id
VITE_NEON_BRANCH_ID=seu-branch-id
